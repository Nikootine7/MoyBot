# MOYBOT Phase 1 environment.
#
# Phase 1 is alert-only and offline (see docs/DECISIONS.md, D-003 and D-004):
# there are no provider API keys, no RPC endpoints, and no wallet keys.
# Never add signing keys or provider credentials to this file.

# Directory for newline-delimited JSON snapshots and provenance records.
MOYBOT_DATA_DIR=./.moybot-data

# Log level for the structured stdout logger.
MOYBOT_LOG_LEVEL=INFO
